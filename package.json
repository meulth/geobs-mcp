{
  "name": "geobs-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP server for accessing Basel-Stadt geospatial data via STAC, OGC API Features and GeoBS APIs.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:node": "node scripts/build-node.mjs",
    "release:node": "node scripts/build-node.mjs --release",
    "test:node-build": "node scripts/smoke-node.mjs",
    "test:container": "node scripts/smoke-container.mjs",
    "test:helm": "node scripts/test-helm.mjs",
    "test:docs": "node scripts/smoke-docs.mjs",
    "catalog:prepare": "esbuild scripts/prepare-catalog.ts --bundle --platform=node --format=esm --outfile=.wrangler/prepare-catalog.mjs && node .wrangler/prepare-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cloudflare/workers-types": "latest",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.1",
    "esbuild": "0.28.2",
    "swagger-ui-dist": "5.34.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0",
    "yaml": "2.9.1"
  }
}
