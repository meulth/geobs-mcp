{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "service", "config", "catalog", "persistence", "apiKey", "refresh", "resources", "podSecurityContext", "containerSecurityContext", "probes"],
  "properties": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}}}},
    "nameOverride": {"$ref": "#/definitions/optionalName"},
    "fullnameOverride": {"$ref": "#/definitions/optionalName"},
    "replicaCount": {"type": "integer", "minimum": 1},
    "service": {
      "type": "object", "additionalProperties": false, "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "config": {
      "type": "object", "additionalProperties": false, "required": ["bindAddress", "allowedHosts", "allowedOrigins"],
      "properties": {
        "bindAddress": {"enum": ["0.0.0.0", "::"]},
        "publicBasePath": {"type": "string", "maxLength": 200, "pattern": "^(/[A-Za-z0-9_-]+)*$", "not": {"pattern": "^/(mcp|docs|health)(/|$)"}},
        "allowedHosts": {"$ref": "#/definitions/stringList"},
        "allowedOrigins": {"$ref": "#/definitions/stringList"},
        "maxConcurrentRequests": {"type": "integer", "minimum": 1, "maximum": 9999}
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["mountPath", "fileName", "initialize"],
      "properties": {
        "mountPath": {"type": "string", "pattern": "^/([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$"},
        "fileName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
        "initialize": {"type": "boolean"}
      }
    },
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": ["existingClaim", "accessModes", "size", "retain", "annotations", "allowSingleNodeAccess"],
      "properties": {
        "existingClaim": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "storageClassName": {"type": ["string", "null"]},
        "accessModes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["ReadWriteMany", "ReadWriteOnce"]}},
        "size": {"type": "string", "minLength": 1},
        "retain": {"type": "boolean"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "allowSingleNodeAccess": {"type": "boolean"}
      }
    },
    "apiKey": {
      "type": "object", "additionalProperties": false, "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "key": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"}
      }
    },
    "refresh": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "schedule", "timeZone", "suspend", "startingDeadlineSeconds", "activeDeadlineSeconds", "backoffLimit", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string", "minLength": 1},
        "suspend": {"type": "boolean"},
        "startingDeadlineSeconds": {"type": "integer", "minimum": 10},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"}
      }
    },
    "resources": {"type": "object"},
    "podSecurityContext": {
      "type": "object", "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "fsGroup": {"type": "integer", "minimum": 1}
      }
    },
    "containerSecurityContext": {"type": "object"},
    "probes": {
      "type": "object", "additionalProperties": false, "required": ["host", "liveness", "readiness"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "liveness": {"$ref": "#/definitions/probeTiming"},
        "readiness": {"$ref": "#/definitions/probeTiming"}
      }
    },
    "serviceAccountName": {"$ref": "#/definitions/optionalName"},
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "optionalName": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "stringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "probeTiming": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "successThreshold": {"const": 1}
      }
    }
  }
}
